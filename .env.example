# ═══════════════════════════════════════════════════════════════
# ClientForge AI — environment configuration
#
# Copy to .env and fill in. NEVER commit real values.
# Anything left blank falls back to a safe local default, and any integration
# whose credentials are absent reports itself as "not configured" rather than
# pretending to work.
# ═══════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=development
# development | staging | production
APP_ENV=development
APP_VERSION=2.0.0
PORT=3000
# Comma-separated list of hosts allowed to reach the app behind a proxy.
# APP_URL=https://app.example.com

# ── Database ─────────────────────────────────────────────────
# SQLite file path. Defaults to .data/acquisition.db when unset.
# OS_DATABASE=/var/lib/clientforge/acquisition.db

# ── Secrets ──────────────────────────────────────────────────
# Master key used to encrypt provider credentials at rest (AES-256-GCM).
# REQUIRED IN PRODUCTION. When unset, a key file is generated at
# .data/master.key — acceptable for local development only, because the key
# cannot be shared across instances or restored from backup portably.
# Generate with:  openssl rand -hex 32
# OS_MASTER_KEY=

# ── Session / auth ───────────────────────────────────────────
# Session cookie lifetime in days. Default 30.
# SESSION_DAYS=30
# Set to 1 behind HTTPS so cookies are only sent over TLS. Automatic in production.
# COOKIE_SECURE=1

# ── AI providers ─────────────────────────────────────────────
# All optional. With none set, the local grounded engine handles every task:
# outputs remain grounded in supplied facts, but there is no hosted-model
# reasoning. The model router prefers a hosted model when one is configured.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=

# ── Discovery / data providers ───────────────────────────────
# OpenStreetMap Overpass needs no key and works out of the box.
# OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# GOOGLE_PLACES_API_KEY=
# SERPAPI_KEY=
# OPENCORPORATES_TOKEN=
# YELP_API_KEY=

# ── Enrichment ───────────────────────────────────────────────
# HUNTER_API_KEY=
# CLEARBIT_SECRET_KEY=
# APOLLO_API_KEY=

# ── Email / SMS / WhatsApp ───────────────────────────────────
# With none set, messages are written to the local outbox and marked
# "simulated" — they are never reported as sent.
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# Twilio format: ACCOUNT_SID:AUTH_TOKEN from=+15551234567
# TWILIO_SMS=
# TWILIO_WHATSAPP=ACCOUNT_SID:AUTH_TOKEN from=whatsapp:+15551234567

# ── Hosting / deployment ─────────────────────────────────────
# With none set, sites are served in-app at /site/[id] and deployments are
# reported as "simulated" — never as a successful production deploy.
# VERCEL_TOKEN=
# NETLIFY_TOKEN=
# GITHUB_TOKEN=

# ── Payments ─────────────────────────────────────────────────
# With none set, invoices are recorded as "pending" / "not_configured".
# A payment is only ever marked paid when the provider confirms it.
# STRIPE_SECRET_KEY=

# ── Social publishing ────────────────────────────────────────
# BUFFER_ACCESS_TOKEN=
# META_ACCESS_TOKEN=

# ── Monitoring ───────────────────────────────────────────────
# Optional external error reporting. When unset, errors are written to the
# automation log and surfaced in the Automation Center.
# SENTRY_DSN=

# ── Backups ──────────────────────────────────────────────────
# Number of verified backups to retain. Default 14.
# BACKUP_RETENTION=14

# ── Automation ───────────────────────────────────────────────
# Daily discovery cron. Default "0 2 * * *" (02:00 daily).
# DISCOVERY_CRON=0 2 * * *
# DISCOVERY_TIMEZONE=UTC

# ── Safety limits ────────────────────────────────────────────
# Hard caps enforced regardless of UI settings.
# MAX_DAILY_SENDS=50
# MAX_DOMAIN_DAILY_SENDS=30

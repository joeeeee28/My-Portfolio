+  credentials_ready INTEGER NOT NULL DEFAULT 0,
+  failure_rate      REAL NOT NULL DEFAULT 0,
+  avg_latency_ms    INTEGER,
+  notes             TEXT,
+  created_at        TEXT NOT NULL,
+  updated_at        TEXT NOT NULL,
+  UNIQUE(org_id, provider_key, model_id)

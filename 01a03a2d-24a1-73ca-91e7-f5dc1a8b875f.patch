+
+console.log('\n' + '═'.repeat(48));
+console.log(`  ${passed} passed · ${failed} failed`);
+if (failures.length) {
+  console.log('\n  Failures:');
+  for (const f of failures) console.log(`    ✗ ${f}`);
+}
+console.log('═'.repeat(48) + '\n');

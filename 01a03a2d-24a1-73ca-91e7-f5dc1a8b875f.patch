+  is_active         INTEGER NOT NULL DEFAULT 1,
+  preferred_industries TEXT NOT NULL DEFAULT '[]',
+  excluded_industries  TEXT NOT NULL DEFAULT '[]',
+  business_sizes    TEXT NOT NULL DEFAULT '[]',
+  services          TEXT NOT NULL DEFAULT '[]',

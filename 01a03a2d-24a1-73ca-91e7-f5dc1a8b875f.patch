+export function listUpsells(orgId: string, opts: { clientId?: string; status?: string; limit?: number } = {}) {
+  const where = ['u.org_id = ?'];
+  const params: unknown[] = [orgId];
+  if (opts.clientId) {
+    where.push('u.client_id = ?');

+              const totalSteps = seq ? (seq.steps as unknown[]).length : 0;
+              return (
+                <tr key={e.id}>
+                  <td>
+                    <Link href={`/prospects/${e.business_id}`} className="small strong" style={{ color: 'var(--accent)' }}>

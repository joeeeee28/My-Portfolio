+export type ResponseClassification =
+  | 'interested'
+  | 'not_interested'
+  | 'maybe'
+  | 'pricing_question'
+  | 'info_request'
+  | 'wants_call'
+  | 'objection'
+  | 'opt_out'
+  | 'unknown';

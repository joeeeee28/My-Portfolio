+/**
+ * Workspace defaults: scoring profile, ICP, service packages, sequences and
+ * automation jobs. Idempotent — safe to call on every boot.
+ */
+import { get, run, toJson } from '@/db';
+import { id, nowIso } from '@/lib/id';

+}
+.auth-mark svg { width: 20px; height: 20px; }
+.auth-name { font-size: 17px; font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; }
+.auth-name .ai { font-weight: 500; color: var(--text-3); font-size: 13px; margin-left: 3px; }
+.auth-tag { font-size: 11px; color: var(--text-3); margin-top: 2px; }
+.auth-title { font-size: 19px; margin: 0; }
+.auth-sub { font-size: 13px; color: var(--text-2); margin: 0 0 4px; line-height: 1.55; }
+.auth-foot {
+  display: flex; gap: 7px; align-items: flex-start;
+  margin-top: 10px; padding-top: 12px; border-top: 1px solid var(--border);
+  font-size: 11px; color: var(--text-3); line-height: 1.5;
+}
+.auth-foot svg { flex-shrink: 0; margin-top: 1px; }

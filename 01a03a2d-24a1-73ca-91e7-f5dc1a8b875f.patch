+function uniqueSlug(orgId: string, base: string): string {
+  let candidate = base || 'concept';
+  let n = 2;
+  while (scalar<number>('SELECT COUNT(*) FROM mockups WHERE org_id = ? AND slug = ?', [orgId, candidate])) {
+    candidate = `${base}-${n++}`;
+  }
+  return candidate;
+}

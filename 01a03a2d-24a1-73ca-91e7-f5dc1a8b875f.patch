+// ── Tones (§16) ──────────────────────────────────────────────
+export const TONES = ['friendly', 'professional', 'direct', 'value_first', 'consultative'] as const;
+export type Tone = (typeof TONES)[number];
+export const TONE_LABELS: Record<Tone, string> = {

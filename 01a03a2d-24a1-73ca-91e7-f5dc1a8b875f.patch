+.label { font-size: 11.5px; font-weight: 600; color: var(--text-2); }
+.label .req { color: var(--critical); }
+.input, .select, .textarea {
+  width: 100%; padding: 6px 9px;
+  border: 1px solid var(--border); border-radius: var(--radius-sm);
+  background: var(--surface); color: var(--text);
+  font-size: 13px; font-family: inherit;
+}
+.input:focus, .select:focus, .textarea:focus { outline: 2px solid var(--accent-ring); border-color: var(--accent); outline-offset: 0; }
+.textarea { resize: vertical; min-height: 72px; line-height: 1.5; }
+.hint { font-size: 11px; color: var(--text-3); }
+.switch { display: inline-flex; align-items: center; gap: 7px; cursor: pointer; font-size: 13px; }
+.switch input { width: 15px; height: 15px; accent-color: var(--accent); }
+
+/* ── Empty state (§72) ───────────────────────────────────── */
+.empty {
+  display: flex; flex-direction: column; align-items: center; justify-content: center;
+  padding: 44px 24px; text-align: center; gap: 8px;
+  border: 1px dashed var(--border-strong); border-radius: var(--radius);
+  background: var(--surface);
+}
+.empty-icon { width: 34px; height: 34px; border-radius: var(--radius); background: var(--surface-2); display: grid; place-items: center; color: var(--text-3); }
+.empty-icon svg { width: 17px; height: 17px; }
+.empty-title { font-size: 14px; font-weight: 650; }
+.empty-body { font-size: 12.5px; color: var(--text-3); max-width: 46ch; }
+
+/* ── AI treatment (subtle, per brand) ────────────────────── */
+.ai-panel { border-left: 2px solid var(--ai); background: var(--surface); border-radius: 0 var(--radius) var(--radius) 0; }
+.ai-tag { display: inline-flex; align-items: center; gap: 4px; font-size: 10.5px; font-weight: 650; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ai); }
+.ai-tag svg { width: 11px; height: 11px; }
+
+/* ── Banners ─────────────────────────────────────────────── */
+.banner { display: flex; gap: 10px; align-items: flex-start; padding: 10px 13px; border-radius: var(--radius); border: 1px solid var(--border); background: var(--surface-2); font-size: 12.5px; }
+.banner.accent { background: var(--accent-soft); border-color: var(--accent-ring); }
+.banner.warning { background: var(--warning-soft); border-color: var(--warning); }
+.banner.critical { background: var(--critical-soft); border-color: var(--critical); }
+.banner.success { background: var(--success-soft); border-color: var(--success); }
+.banner-icon { flex-shrink: 0; margin-top: 1px; }
+.banner-icon svg { width: 15px; height: 15px; }
+
+/* ── Demo marker (§73) ───────────────────────────────────── */
+.demo-flag {
+  display: inline-flex; align-items: center; gap: 3px;
+  font-size: 10px; font-weight: 650; text-transform: uppercase; letter-spacing: 0.04em;
+  color: var(--warning); background: var(--warning-soft);
+  padding: 0 5px; border-radius: 3px;
+}
+
+/* ── Hero / briefing ─────────────────────────────────────── */
+.briefing {
+  padding: 20px 22px;

+    'consent_at', 'last_verified_at', 'source_confidence', 'is_archived', 'archived_reason', 'is_demo',
+  ]);
+  const entries = Object.entries(patch).filter(([k]) => allowed.has(k));
+  if (!entries.length) return getBusiness(orgId, businessId);

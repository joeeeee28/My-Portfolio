+  color: var(--text-3); padding: 8px 12px; border-bottom: 1px solid var(--border); background: var(--surface-2);
+  white-space: nowrap; position: sticky; top: 0; z-index: 1;
+}
+.table td { padding: 9px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; }
+.table tbody tr:last-child td { border-bottom: none; }
+.table tbody tr:hover { background: var(--surface-2); }
+.table .num { text-align: right; font-variant-numeric: tabular-nums; }
+.table-compact td { padding: 6px 10px; font-size: 12.5px; }
+.table-scroll { overflow-x: auto; }
+
+/* ── Badges & chips ──────────────────────────────────────── */
+.badge {
+  display: inline-flex; align-items: center; gap: 4px;
+  padding: 1px 7px; border-radius: 10px;
+  font-size: 11px; font-weight: 600; line-height: 1.6;
+  background: var(--neutral-soft); color: var(--neutral);
+  white-space: nowrap;
+}
+.badge-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
+.badge.accent { background: var(--accent-soft); color: var(--accent); }
+.badge.success { background: var(--success-soft); color: var(--success); }
+.badge.warning { background: var(--warning-soft); color: var(--warning); }
+.badge.critical { background: var(--critical-soft); color: var(--critical); }
+.badge.ai { background: var(--ai-soft); color: var(--ai); }
+.badge.outline { background: transparent; border: 1px solid var(--border); color: var(--text-2); }
+
+.chip {
+  display: inline-flex; align-items: center; gap: 5px;
+  padding: 2px 8px; border-radius: var(--radius-sm);
+  border: 1px solid var(--border); background: var(--surface);
+  font-size: 12px; color: var(--text-2);
+}
+.chip.active { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
+
+/* ── Score ───────────────────────────────────────────────── */
+.score {
+  display: inline-flex; align-items: center; justify-content: center;
+  min-width: 34px; height: 24px; padding: 0 7px;
+  border-radius: var(--radius-sm);
+  font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums;
+  background: var(--neutral-soft); color: var(--neutral);
+}
+.score.critical { background: var(--critical-soft); color: var(--critical); }
+.score.high { background: var(--accent-soft); color: var(--accent); }
+.score.medium { background: var(--warning-soft); color: var(--warning); }
+.score.low { background: var(--neutral-soft); color: var(--neutral); }
+
+.score-big { display: flex; align-items: baseline; gap: 8px; }
+.score-big .value { font-size: 34px; font-weight: 750; letter-spacing: -0.035em; line-height: 1; font-variant-numeric: tabular-nums; }
+.score-big.critical .value { color: var(--critical); }
+.score-big.high .value { color: var(--accent); }
+.score-big.medium .value { color: var(--warning); }
+
+/* ── Progress ────────────────────────────────────────────── */
+.bar { height: 5px; background: var(--ink-100); border-radius: 3px; overflow: hidden; }
+.bar-fill { height: 100%; background: var(--accent); border-radius: 3px; transition: width 0.3s ease; }
+.bar-fill.success { background: var(--success); }
+.bar-fill.warning { background: var(--warning); }
+.bar-fill.critical { background: var(--critical); }
+.bar-fill.ai { background: var(--ai); }
+
+/* ── Action Queue ────────────────────────────────────────── */
+.queue { display: flex; flex-direction: column; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--surface); }
+.queue-item {
+  display: flex; gap: 11px; align-items: flex-start;
+  padding: 11px 13px;
+  border-bottom: 1px solid var(--border);
+}
+.queue-item:last-child { border-bottom: none; }
+.queue-item:hover { background: var(--surface-2); }
+.queue-stripe { width: 3px; align-self: stretch; border-radius: 2px; background: var(--neutral); flex-shrink: 0; margin: -11px 0 -11px -13px; padding-left: 3px; }
+.queue-stripe.critical { background: var(--critical); }
+.queue-stripe.high { background: var(--accent); }
+.queue-stripe.medium { background: var(--warning); }
+.queue-stripe.low { background: var(--neutral); }
+.queue-main { flex: 1; min-width: 0; }
+.queue-title { font-size: 13px; font-weight: 600; }
+.queue-kind { font-size: 10.5px; font-weight: 650; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-3); }
+.queue-reason { font-size: 12.5px; color: var(--text-2); margin-top: 2px; }
+
+/* ── Funnel ──────────────────────────────────────────────── */
+.funnel { display: flex; flex-direction: column; gap: 5px; }
+.funnel-row { display: grid; grid-template-columns: 108px 1fr 108px; gap: 10px; align-items: center; font-size: 12.5px; }
+.funnel-bar { height: 22px; background: var(--ink-100); border-radius: 3px; overflow: hidden; }
+.funnel-fill { height: 100%; background: var(--accent); opacity: 0.85; border-radius: 3px; }
+.funnel-meta { text-align: right; color: var(--text-3); font-variant-numeric: tabular-nums; }
+
+/* ── Pipeline board ──────────────────────────────────────── */
+.board { display: flex; gap: 10px; overflow-x: auto; padding-bottom: 8px; }
+.board-col { min-width: 200px; flex: 1; background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius); }
+.board-col-head { padding: 8px 10px; border-bottom: 1px solid var(--border); display: flex; align-items: baseline; gap: 6px; }
+.board-col-title { font-size: 11px; font-weight: 650; text-transform: uppercase; letter-spacing: 0.05em; }
+.board-col-count { margin-left: auto; font-size: 11px; color: var(--text-3); font-variant-numeric: tabular-nums; }
+.board-col-body { padding: 8px; display: flex; flex-direction: column; gap: 6px; min-height: 60px; max-height: 62vh; overflow-y: auto; }
+.board-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 8px 9px; }
+.board-card:hover { border-color: var(--border-strong); }
+.board-card-name { font-size: 12.5px; font-weight: 600; }
+.board-card-meta { font-size: 11px; color: var(--text-3); margin-top: 3px; }
+
+/* ── Timeline ────────────────────────────────────────────── */
+.timeline { display: flex; flex-direction: column; }
+.timeline-item { display: flex; gap: 11px; padding: 8px 0; position: relative; }
+.timeline-item:not(:last-child)::before {
+  content: ""; position: absolute; left: 9px; top: 26px; bottom: -4px; width: 1px; background: var(--border);
+}
+.timeline-dot {
+  width: 19px; height: 19px; border-radius: 50%; flex-shrink: 0;
+  display: grid; place-items: center;
+  background: var(--surface-2); border: 1px solid var(--border); color: var(--text-3);
+}
+.timeline-dot svg { width: 10px; height: 10px; }
+.timeline-dot.accent { background: var(--accent-soft); border-color: var(--accent-ring); color: var(--accent); }
+.timeline-dot.success { background: var(--success-soft); border-color: var(--success); color: var(--success); }
+.timeline-dot.critical { background: var(--critical-soft); border-color: var(--critical); color: var(--critical); }
+.timeline-dot.ai { background: var(--ai-soft); border-color: var(--ai); color: var(--ai); }
+.timeline-when { font-size: 11px; color: var(--text-3); font-variant-numeric: tabular-nums; }
+.timeline-what { font-size: 12.5px; }
+.timeline-detail { font-size: 11.5px; color: var(--text-3); margin-top: 1px; }
+
+/* ── Tabs ────────────────────────────────────────────────── */
+.tabs { display: flex; gap: 1px; border-bottom: 1px solid var(--border); overflow-x: auto; }
+.tab {
+  padding: 8px 13px; font-size: 13px; font-weight: 550; color: var(--text-3);
+  border-bottom: 2px solid transparent; margin-bottom: -1px; white-space: nowrap; cursor: pointer;
+  background: none; border-top: none; border-left: none; border-right: none;
+}
+.tab:hover { color: var(--text); }
+.tab.active { color: var(--accent); border-bottom-color: var(--accent); font-weight: 650; }
+
+/* ── Forms ───────────────────────────────────────────────── */

+                </div>
+                <div>
+                  <div className="xsmall muted">Call briefing</div>
+                  <pre style={{ whiteSpace: 'pre-wrap', fontFamily: 'inherit', fontSize: 12.5, background: 'var(--surface-2)', padding: 10, borderRadius: 4, margin: '4px 0 0' }}>

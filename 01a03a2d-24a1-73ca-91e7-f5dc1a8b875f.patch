+  priority          TEXT NOT NULL,
+  service_fit       TEXT,
+  computed_at       TEXT NOT NULL,
+  created_at        TEXT NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_opp_biz ON opportunity_scores(business_id, computed_at DESC);
+
+CREATE TABLE IF NOT EXISTS icp_profiles (
+  id                TEXT PRIMARY KEY,

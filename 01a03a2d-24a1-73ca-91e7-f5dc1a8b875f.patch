+  const sets = entries.map(([k]) => `${k} = ?`).join(', ');
+  const values = entries.map(([, v]) => (typeof v === 'object' && v !== null ? toJson(v) : v));
+  run(`UPDATE businesses SET ${sets}, updated_at = ? WHERE id = ? AND org_id = ?`, [

+/** Canonical domain vocabulary. Every stage/status used across the platform lives here. */
+
+// ── Pipeline (§26) ───────────────────────────────────────────
+export const PIPELINE_STAGES = [
+  'discovered',
+  'qualified',
+  'outreach_ready',
+  'outreach_sent',
+  'engaged',
+  'interested',
+  'mockup_generated',

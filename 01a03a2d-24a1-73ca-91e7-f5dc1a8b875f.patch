+export const SOCIAL_PROVIDERS: SocialProvider[] = [bufferProvider, metaGraphProvider, socialOutboxProvider];
+
+// ═════════════════════════════════════════════════════════════
+// IMAGE GENERATION (§22)
+// ═════════════════════════════════════════════════════════════
+export const openaiImageProvider: ImageProvider = {

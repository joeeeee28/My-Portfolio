+                  </td>
+                  <td className="num small mono">v{m.current_version}</td>
+                  <td>
+                    <Badge tone={m.status === 'viewed' ? 'success' : m.status === 'shared' ? 'accent' : 'warning'} dot>
+                      {m.status}

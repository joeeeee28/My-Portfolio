+// ── Approval modes (§18) ─────────────────────────────────────
+export const APPROVAL_MODES = ['manual', 'assisted', 'autonomous'] as const;
+export type ApprovalMode = (typeof APPROVAL_MODES)[number];
+export const APPROVAL_MODE_LABELS: Record<ApprovalMode, string> = {

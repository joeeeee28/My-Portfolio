+    type: 'hero',
+    id: 'hero',
+    title: tagline.headline,
+    subtitle: tagline.subheadline,
+    cta: primaryCta(input, theme),
+    body: input.description ? firstClause(input.description) : undefined,
+  });
+
+  // Trust bar — only when there is something real to show.
+  const trust: string[] = [];

+export interface ProjectRow {
+  id: string;
+  org_id: string;
+  client_id: string;
+  business_id: string;
+  proposal_id: string | null;
+  name: string;
+  kind: string;
+  stage: ProjectStage;
+  status: string;
+  progress: number;
+  starts_at: string | null;
+  due_at: string | null;
+  health: string;

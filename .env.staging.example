# ═══════════════════════════════════════════════════════════════
# ClientForge AI — STAGING environment
#
# Copy to .env.staging. NEVER commit real values.
# Staging must never point at production credentials or a production database.
# ═══════════════════════════════════════════════════════════════

# ── Required ─────────────────────────────────────────────────
NODE_ENV=production
APP_ENV=staging
APP_VERSION=2.0.0-staging

# Encrypts stored provider credentials at rest. Generate with:
#   openssl rand -hex 32
# Use a DIFFERENT key from production so staging credentials cannot decrypt
# production secrets and vice versa.
OS_MASTER_KEY=

# ── Database ─────────────────────────────────────────────────
# Use a separate database file from production. SQLite needs a writable
# persistent disk — this rules out pure serverless hosts.
OS_DATABASE=./.data/staging.db

# ── Scheduler ────────────────────────────────────────────────
# Keep the production schedule so staging verifies the real behaviour.
# On a host that sleeps between requests, add an external cron trigger.
DISCOVERY_CRON=0 2 * * *
DISCOVERY_TIMEZONE=UTC

# ── AI (all optional) ────────────────────────────────────────
# With none set, the local grounded engine handles every task at zero cost.
# OLLAMA_HOST gives you real local inference, still free, with no data egress.
# OLLAMA_HOST=http://localhost:11434
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=

# ── Discovery (optional) ─────────────────────────────────────
# OpenStreetMap Overpass needs no key and is the zero-cost default.
# OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# GOOGLE_PLACES_API_KEY=
# SERPAPI_KEY=
# YELP_API_KEY=
# OPENCORPORATES_TOKEN=

# ── Email (optional) ─────────────────────────────────────────
# Use a STAGING sending domain, never the production one. Configure SPF, DKIM
# and DMARC before sending anything real.
# RESEND_API_KEY=
# SENDGRID_API_KEY=

# ── SMS / WhatsApp (optional, no permanent free tier) ────────
# Format: ACCOUNT_SID:AUTH_TOKEN from=+15551234567
# TWILIO_SMS=
# TWILIO_WHATSAPP=

# ── Hosting (optional) ───────────────────────────────────────
# Without one, sites are served in-app and deployments report as simulated.
# VERCEL_TOKEN=
# NETLIFY_TOKEN=

# ── Payments (optional) ──────────────────────────────────────
# Use Stripe TEST mode in staging. A payment is only ever marked paid when the
# provider confirms it.
# STRIPE_SECRET_KEY=sk_test_...

# ── Monitoring (optional) ────────────────────────────────────
# SENTRY_DSN=

# ── Safety limits ────────────────────────────────────────────
# Keep staging limits LOW so a misconfigured run cannot send real volume.
MAX_DAILY_SENDS=5
MAX_DOMAIN_DAILY_SENDS=3

# ── Backups ──────────────────────────────────────────────────
BACKUP_RETENTION=5
